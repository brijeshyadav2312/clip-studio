# Copy to .env and fill in what you need.

# --- Highlight ranking -------------------------------------------------------
# gemini | openai | heuristic  (leave blank to auto-detect from keys)
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Transcription -----------------------------------------------------------
# tiny | base | small | medium | large-v3  (bigger = better + slower on CPU)
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# --- Output & Layout ---------------------------------------------------------
CLIP_NUM=5
CLIP_MIN_SEC=20
CLIP_MAX_SEC=60
CLIP_TARGET_SEC=40
# auto | streamer_split | gameplay_center | gameplay_blur | streamer_pip | crop | blur
CLIP_LAYOUT=auto
# locked_tripod | smooth_cinematic | dynamic
CLIP_STABILIZATION=locked_tripod
CLIP_PODCAST_DWELL_SEC=2.5

# --- Streamer & Gaming Customization -----------------------------------------
# center (GTA car/crosshairs) | center_low | center_high | action_track
CLIP_STREAMER_GAME_FOCUS=center
# 35_65 | 30_70 | 40_60 | 50_50
CLIP_STREAMER_SPLIT=35_65
# auto | top-left | top-right | bottom-left | bottom-right
CLIP_STREAMER_CAM_POS=auto
# 1.0 | 1.15 | 1.35 | 1.5
CLIP_STREAMER_CAM_ZOOM=1.15
# glow | subtle | none
CLIP_STREAMER_DIVIDER=glow
# purple_cyan | cyan | gold | red | white
CLIP_STREAMER_THEME=purple_cyan
# Optional overlay tag/handle, e.g. @streamer
CLIP_STREAMER_TAG=
# rect | rounded
CLIP_STREAMER_CAM_SHAPE=rect
# blur | dark | black
CLIP_STREAMER_BG=blur

# wordpop | karaoke | hormozi | clean
CLIP_CAPTION_STYLE=wordpop
CLIP_FONT=Arial Black
CLIP_FPS=30
CLIP_CRF=20
CLIP_ENCODER=libx264

# --- Downloads ---------------------------------------------------------------
# If YouTube asks you to sign in ("confirm you're not a bot"), set your browser:
# chrome | edge | firefox | brave | chromium
CLIP_COOKIES_FROM_BROWSER=
